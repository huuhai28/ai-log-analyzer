# Copy thành .env (đã có trong .gitignore) rồi điền giá trị thật.

# ---- AI phân tích log (OpenAI Responses API) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Đổi nếu dùng dịch vụ tương thích OpenAI khác
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Gửi kết quả qua Telegram (tùy chọn) ----
# Tạo bot với @BotFather → token; nhắn cho bot 1 tin rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- App cần giám sát ----
# Regex tên docker compose project cần thu log
WATCH_PROJECTS=^(personal-web-platform|personal-web-prod)$
# Mô tả hệ thống cho AI hiểu ngữ cảnh
SYSTEM_DESCRIPTION=website portfolio gồm nginx, FastAPI, Celery worker, PostgreSQL, Redis, Keycloak chạy bằng Docker Compose
LOG_WINDOW_MINUTES=15

# ---- Mật khẩu giao diện ----
GRAFANA_ADMIN_PASSWORD=change-me
# Khóa mã hóa credential của n8n: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me
